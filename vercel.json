{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/notifications/(?<id>[^/]+)/pin", "dest": "/api/notifications?id=$id" },
    { "src": "/api/notifications/(?<id>[^/]+)", "dest": "/api/notifications?id=$id" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
